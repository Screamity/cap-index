{
  "description": "cap-index capability catalog and index refresh (requires Node.js 18+)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/cap-index.bundle.mjs",
              "hook",
              "session-start",
              "--client",
              "qoder"
            ],
            "name": "cap-index-catalog",
            "timeout": 8
          }
        ]
      },
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/cap-index.bundle.mjs",
              "build",
              "--if-stale",
              "--quiet",
              "--sync-runtime",
              "--client",
              "qoder"
            ],
            "name": "cap-index-refresh",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
